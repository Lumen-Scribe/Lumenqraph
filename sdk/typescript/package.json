{
  "name": "@lumenqraph/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Lumenqraph Soroban event-indexer API (REST + GraphQL).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumen-Scribe/Lumenqraph",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc src/index.ts --out docs --readme README.md",
    "codegen": "openapi-typescript ../../openapi.yaml -o generated/api.d.ts",
    "codegen:check": "node scripts/check-codegen.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "indexer",
    "graphql",
    "lumenqraph"
  ],
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "openapi-typescript": "^7.13.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.2.1"
  }
}
