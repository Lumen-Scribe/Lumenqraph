    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Transfer-like events skipped by the SEP-41 gate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
