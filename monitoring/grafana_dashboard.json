      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(lumenqraph_indexer_transfer_projection_skipped_total{job=~\"$job\",instance=~\"$instance\"}[5m])",
