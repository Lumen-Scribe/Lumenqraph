{
  "name": "lumenqraph-explorer",
  "version": "0.1.0",
  "description": "Lumenqraph blockchain explorer web UI",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --outfile=dist/explorer.js && node scripts/build.mjs",
    "dev": "esbuild src/main.ts --bundle --watch --outfile=dist/explorer.js",
    "lint": "eslint src --max-warnings=0",
    "test": "playwright test",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
